{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "physical_writes_enabled",
    "verify_after_write"
  ],
  "properties": {
    "mode": {
      "const": "simulator"
    },
    "physical_writes_enabled": {
      "const": false
    },
    "verify_after_write": {
      "const": true
    },
    "state_dir": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 2,
        "pattern": "^/"
      }
    },
    "restore_roots": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 2,
        "pattern": "^/"
      }
    }
  }
}
