{
  "name": "tapepilot-web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --plugin prettier-plugin-svelte --check src",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "dev": "vite dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "3.5.2",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "packageManager": "npm@11.19.1"
}
